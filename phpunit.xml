<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.x/phpunit.xsd"
         bootstrap="tests/Bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="false"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
         colors="true">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <const name="SMF" value="true"/>
        <const name="SMM_NAME" value="Simple Mod Maker"/>
        <const name="SMF_VERSION" value="3.0.0"/>
        <const name="SMM_FILENAME_PATTERN" value="^(?:Class-)?[A-Z][a-zA-Z]+$"/>
        <const name="SMM_MODNAME_DEFAULT" value="My New Mod"/>
        <const name="SMM_VENDOR_DEFAULT" value="MyMods"/>
    </php>

    <source>
        <include>
            <directory suffix=".php">./src/Sources/SimpleModMaker</directory>
        </include>
        <exclude>
            <directory>./tests</directory>
            <directory>./vendor</directory>
            <directory>./src/Sources/SimpleModMaker/vendor</directory>
            <file>./src/Sources/SimpleModMaker/app.php</file>
            <file>./src/Sources/SimpleModMaker/index.php</file>
            <file>./src/Sources/SimpleModMaker/Printer.php</file>
            <file>./src/Sources/SimpleModMaker/Hooks/index.php</file>
            <file>./src/Sources/SimpleModMaker/licenses/index.php</file>
        </exclude>
    </source>
</phpunit>